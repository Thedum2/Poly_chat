# Copy to .env.local in the repository root; this file is loaded only by the relay.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
POLYCHAT_RELAY_HOST=127.0.0.1
POLYCHAT_RELAY_PORT=3001
# Exact frontend origins, comma separated. Same-origin local requests also work.
POLYCHAT_ALLOWED_ORIGINS=https://galashow.cloud,https://dev.galashow.cloud
