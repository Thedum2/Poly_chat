{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "PolyChat demo: private S3 site, API relay Lambda and HTTPS CloudFront distribution",
  "Parameters": {
    "StageName": {
      "Type": "String",
      "AllowedValues": [
        "dev",
        "prod"
      ]
    },
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:acm:us-east-1:.*"
    },
    "DomainName": {
      "Type": "String",
      "Default": "polychat.galashow.cloud",
      "AllowedPattern": "[a-z0-9.-]+\\.galashow\\.cloud"
    },
    "RelayCodeBucket": {
      "Type": "String"
    },
    "RelayCodeKey": {
      "Type": "String"
    },
    "RelayAdapterLayerArn": {
      "Type": "String",
      "Default": "arn:aws:lambda:ap-northeast-2:753240598075:layer:LambdaAdapterLayerX86:27"
    },
    "ChzzkClientId": {
      "Type": "String",
      "NoEcho": true,
      "Default": ""
    },
    "ChzzkClientSecret": {
      "Type": "String",
      "NoEcho": true,
      "Default": ""
    },
    "SoopClientId": {
      "Type": "String",
      "NoEcho": true,
      "Default": ""
    },
    "SoopClientSecret": {
      "Type": "String",
      "NoEcho": true,
      "Default": ""
    },
    "YouTubeClientId": {
      "Type": "String",
      "NoEcho": true,
      "Default": ""
    }
  },
  "Resources": {
    "OriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "polychat-demo-${StageName}-s3"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SpaRewrite": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "polychat-demo-${StageName}-spa"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Serve /callback and other demo routes from index.html",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  if (request.uri.indexOf('/assets/') !== 0 && request.uri.indexOf('.') === -1) {\n    request.uri = '/index.html';\n  }\n  return request;\n}\n"
      }
    },
    "CachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "polychat-demo-${StageName}"
          },
          "DefaultTTL": 0,
          "MaxTTL": 31536000,
          "MinTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            },
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true
          }
        }
      }
    },
    "DemoBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "galashow-${AWS::AccountId}-${StageName}-polychat-demo"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            }
          ]
        }
      }
    },
    "DemoDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {
            "Fn::Sub": "PolyChat ${StageName} demo"
          },
          "Aliases": [
            {
              "Ref": "DomainName"
            }
          ],
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_200",
          "Origins": [
            {
              "Id": "web",
              "DomainName": {
                "Fn::GetAtt": [
                  "DemoBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccessControl"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            },
            {
              "Id": "relay",
              "DomainName": {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Fn::GetAtt": [
                          "RelayUrl",
                          "FunctionUrl"
                        ]
                      }
                    ]
                  }
                ]
              },
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ],
                "OriginReadTimeout": 60,
                "OriginKeepaliveTimeout": 60
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "web",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": {
              "Ref": "CachePolicy"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SpaRewrite",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "CertificateArn"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/api/*",
              "TargetOriginId": "relay",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "Compress": false,
              "CachePolicyId": {
                "Ref": "RelayCachePolicy"
              },
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "RelayPathRewrite",
                      "FunctionARN"
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "DemoBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DemoBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudFrontRead",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${DemoBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${DemoDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DemoBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DemoBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "DemoDnsA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "DomainName"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "DemoDistribution",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "DemoDnsAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "DomainName"
        },
        "Type": "AAAA",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "DemoDistribution",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "RelayPathRewrite": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "polychat-demo-${StageName}-relay"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Strip the /api prefix before forwarding to the relay",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  request.uri = request.uri.substring(4) || '/';\n  return request;\n}\n"
      }
    },
    "RelayCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "polychat-demo-${StageName}-relay"
          },
          "Comment": "Never cache; the Authorization header is part of the key so CloudFront forwards it",
          "DefaultTTL": 0,
          "MaxTTL": 1,
          "MinTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "whitelist",
              "Headers": [
                "Authorization"
              ]
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "all"
            },
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false
          }
        }
      }
    },
    "RelayLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/polychat-relay-${StageName}"
        },
        "RetentionInDays": 14
      }
    },
    "RelayRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "logs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${RelayLogGroup.Arn}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "RelayFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "RelayLogGroup"
      ],
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "polychat-relay-${StageName}"
        },
        "Description": "PolyChat platform API and YouTube stream relay (Lambda Web Adapter)",
        "Runtime": "nodejs22.x",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "run.sh",
        "Code": {
          "S3Bucket": {
            "Ref": "RelayCodeBucket"
          },
          "S3Key": {
            "Ref": "RelayCodeKey"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "RelayRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 900,
        "Layers": [
          {
            "Ref": "RelayAdapterLayerArn"
          }
        ],
        "Environment": {
          "Variables": {
            "AWS_LAMBDA_EXEC_WRAPPER": "/opt/bootstrap",
            "AWS_LWA_INVOKE_MODE": "response_stream",
            "AWS_LWA_PORT": "8080",
            "AWS_LWA_READINESS_CHECK_PATH": "/config",
            "POLYCHAT_RELAY_HOST": "127.0.0.1",
            "POLYCHAT_RELAY_PORT": "8080",
            "POLYCHAT_ALLOWED_ORIGINS": {
              "Fn::Sub": "https://${DomainName}"
            },
            "CHZZK_CLIENT_ID": {
              "Ref": "ChzzkClientId"
            },
            "CHZZK_CLIENT_SECRET": {
              "Ref": "ChzzkClientSecret"
            },
            "SOOP_CLIENT_ID": {
              "Ref": "SoopClientId"
            },
            "SOOP_CLIENT_SECRET": {
              "Ref": "SoopClientSecret"
            },
            "YOUTUBE_CLIENT_ID": {
              "Ref": "YouTubeClientId"
            }
          }
        }
      }
    },
    "RelayUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "RelayFunction"
        },
        "AuthType": "NONE",
        "InvokeMode": "RESPONSE_STREAM"
      }
    },
    "RelayUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "RelayFunction"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "RelayInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "RelayFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "DemoBucket": {
      "Value": {
        "Ref": "DemoBucket"
      }
    },
    "DemoDistributionId": {
      "Value": {
        "Ref": "DemoDistribution"
      }
    },
    "DemoUrl": {
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      }
    },
    "RelayFunctionUrl": {
      "Value": {
        "Fn::GetAtt": [
          "RelayUrl",
          "FunctionUrl"
        ]
      }
    }
  }
}
